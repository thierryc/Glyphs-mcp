{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "pathDataVersion",
    "engineVersion",
    "unitsPerEm",
    "outlines",
    "sourceNodeIndices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "beztrace-raster-plan"
    },
    "pathDataVersion": {
      "const": 2
    },
    "engineVersion": {
      "type": "string"
    },
    "unitsPerEm": {
      "type": "number",
      "minimum": 16,
      "maximum": 16384
    },
    "outlines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/outline"
      }
    },
    "sourceNodeIndices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4096,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 131072
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "type",
        "smooth"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "type": {
          "enum": [
            "line",
            "curve",
            "offcurve"
          ]
        },
        "smooth": {
          "type": "boolean"
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "nodes"
      ],
      "properties": {
        "closed": {
          "const": true
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contours"
      ],
      "properties": {
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "outline": {
          "$ref": "#/$defs/outline"
        }
      }
    }
  }
}
