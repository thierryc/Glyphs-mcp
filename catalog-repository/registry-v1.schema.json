{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thierryc/glyphs-mcp-skills/registry-v1.schema.json",
  "title": "Glyphs MCP skills catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "author",
          "license",
          "classification",
          "source",
          "compatibleClients",
          "requirements",
          "bundled"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "curated",
              "community"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "repository",
              "directory",
              "revision"
            ],
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "directory": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "archiveSHA256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "compatibleClients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "codex",
                "cursor",
                "claudeCode",
                "chatgpt",
                "claude"
              ]
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bundled": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bundled": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "required": [
                    "archiveSHA256"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
