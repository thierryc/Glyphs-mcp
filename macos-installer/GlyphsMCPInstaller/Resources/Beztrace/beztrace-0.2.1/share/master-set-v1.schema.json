{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unitsPerEm",
    "axis",
    "reference",
    "target",
    "kind",
    "pathDataVersion",
    "engineVersion",
    "options",
    "sourceHashes",
    "contours",
    "interpolation",
    "warnings",
    "sourceMasters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "unitsPerEm": {
      "type": "number",
      "minimum": 16,
      "maximum": 16384
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "locations"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "reference": {
      "$ref": "#/$defs/master"
    },
    "target": {
      "$ref": "#/$defs/master"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referencePolicy": {
          "enum": [
            "fixed",
            "shared-subdivision"
          ]
        },
        "fitTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contourPairs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "startNodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -1
          }
        },
        "preserveStructure": {
          "type": "boolean"
        },
        "maxAdditionalOnCurveNodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "maxOnCurveNodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1024,
          "default": 64
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4096,
          "default": 64
        },
        "smoothJoins": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "kind": {
      "const": "beztrace-master-set"
    },
    "pathDataVersion": {
      "const": 2
    },
    "engineVersion": {
      "type": "string"
    },
    "sourceHashes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "contours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceContour",
          "targetContour",
          "targetStartNode",
          "targetReversed",
          "insertedReferenceNodes",
          "insertedTargetNodes",
          "maximumTargetDeviation",
          "referenceSourceNodes",
          "targetSourceNodes",
          "nodeIDs"
        ],
        "properties": {
          "referenceContour": {
            "type": "integer",
            "minimum": 0
          },
          "targetContour": {
            "type": "integer",
            "minimum": 0
          },
          "targetStartNode": {
            "type": "integer",
            "minimum": 0
          },
          "targetReversed": {
            "type": "boolean"
          },
          "insertedReferenceNodes": {
            "type": "integer",
            "minimum": 0
          },
          "insertedTargetNodes": {
            "type": "integer",
            "minimum": 0
          },
          "maximumTargetDeviation": {
            "type": "number",
            "minimum": 0
          },
          "referenceSourceNodes": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 4096
          },
          "targetSourceNodes": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 4096
          },
          "nodeIDs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 4096
          }
        }
      }
    },
    "interpolation": {
      "type": "object",
      "required": [
        "sampledOnly",
        "nativeHOIVerified",
        "sampleCount",
        "maximumTangencyResidual",
        "issues"
      ],
      "properties": {
        "sampledOnly": {
          "const": true
        },
        "nativeHOIVerified": {
          "const": false
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 3
        },
        "maximumTangencyResidual": {
          "type": "number",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "glyphs4": {
          "type": "object"
        }
      }
    },
    "sourceMasters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/master"
      }
    },
    "rasterSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "masterID",
          "sha256",
          "sourceWidth",
          "sourceHeight",
          "transform",
          "threshold",
          "invert",
          "maximumBoundaryDeviation",
          "options",
          "contourOrder",
          "startBoundaryPoints",
          "reversedContours"
        ],
        "properties": {
          "masterID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "sourceHeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "threshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "invert": {
            "type": "boolean"
          },
          "maximumBoundaryDeviation": {
            "type": "number",
            "minimum": 0
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invert",
              "minimumContourArea",
              "smoothing",
              "cornerThresholdDegrees"
            ],
            "properties": {
              "threshold": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 255
              },
              "invert": {
                "type": "boolean"
              },
              "minimumContourArea": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "smoothing": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 3
              },
              "cornerThresholdDegrees": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              }
            }
          },
          "contourOrder": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "startBoundaryPoints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reversedContours": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "boolean"
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 2
    },
    "nodeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultOnCurves",
        "allowedAdditional",
        "maximumOnCurves"
      ],
      "properties": {
        "referenceOnCurves": {
          "type": "integer",
          "minimum": 0
        },
        "resultOnCurves": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1024
        },
        "addedOnCurves": {
          "type": "integer",
          "minimum": 0
        },
        "allowedAdditional": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "maximumOnCurves": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1024
        },
        "totalNodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4096
        },
        "maximumNodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4096
        }
      }
    },
    "jointSmoothing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligibleJoins",
        "changedHandles",
        "proposedHandleChanges",
        "referenceUnchanged",
        "structurePreserved",
        "sampleCount",
        "nativeHOIVerified",
        "proposalDeviation",
        "beforeMaximumTangencyResidual",
        "afterMaximumTangencyResidual"
      ],
      "properties": {
        "status": {
          "enum": [
            "smoothed",
            "unchanged"
          ]
        },
        "reason": {
          "type": "string"
        },
        "eligibleJoins": {
          "type": "integer",
          "minimum": 0
        },
        "changedHandles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contour",
              "node"
            ],
            "properties": {
              "contour": {
                "type": "integer",
                "minimum": 0
              },
              "node": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "proposedHandleChanges": {
          "type": "integer",
          "minimum": 0
        },
        "proposalDeviation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lowerBound",
            "upperBound",
            "uncertainty"
          ],
          "properties": {
            "lowerBound": {
              "type": "number",
              "minimum": 0
            },
            "upperBound": {
              "type": "number",
              "minimum": 0
            },
            "uncertainty": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "beforeMaximumTangencyResidual": {
          "type": "number",
          "minimum": 0
        },
        "afterMaximumTangencyResidual": {
          "type": "number",
          "minimum": 0
        },
        "referenceUnchanged": {
          "const": true
        },
        "structurePreserved": {
          "const": true
        },
        "sampleCount": {
          "const": 201
        },
        "nativeHOIVerified": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "type",
        "smooth"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "type": {
          "enum": [
            "line",
            "curve",
            "offcurve"
          ]
        },
        "smooth": {
          "type": "boolean"
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "nodes"
      ],
      "properties": {
        "closed": {
          "const": true
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contours"
      ],
      "properties": {
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "outline": {
          "$ref": "#/$defs/outline"
        }
      }
    }
  },
  "title": "beztrace master set v1"
}
