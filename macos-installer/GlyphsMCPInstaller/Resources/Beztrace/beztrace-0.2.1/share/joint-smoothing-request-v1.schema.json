{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beztrace.dev/schema/joint-smoothing-request-v1.json",
  "title": "Reference-locked compatible master smoothing request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reference",
    "target",
    "sourceTarget"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "unitsPerEm": {
      "type": "number",
      "minimum": 16,
      "maximum": 16384,
      "default": 1000
    },
    "fitTolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reference": {
      "$ref": "#/$defs/outline"
    },
    "target": {
      "$ref": "#/$defs/outline"
    },
    "sourceTarget": {
      "$ref": "#/$defs/outline"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "type",
        "smooth"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "type": {
          "enum": [
            "line",
            "curve",
            "offcurve"
          ]
        },
        "smooth": {
          "type": "boolean"
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "nodes"
      ],
      "properties": {
        "closed": {
          "const": true
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contours"
      ],
      "properties": {
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      }
    }
  }
}
