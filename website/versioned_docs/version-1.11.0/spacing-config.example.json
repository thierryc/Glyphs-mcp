{
  "defaults": {
    "area": 400,
    "depth": 15,
    "over": 0,
    "frequency": 5,
    "referenceGlyph": "auto",
    "italicMode": "deslant",
    "includeComponents": true,
    "respectMetricsKeys": true,
    "skipAutoAligned": true,
    "minCoverageRatio": 0.7,
    "tabularMode": "auto",
    "tabularWidth": null,
    "tabularToleranceEm": 0.005
  },
  "guards": {
    "negativeBearingPolicy": "guarded",
    "warnBelowEm": -0.05,
    "blockBelowEm": -0.1,
    "blockOnOutliers": true,
    "allowGlyphs": [],
    "allowItalicOverhangs": true,
    "allowMarks": true,
    "currentMetricsTrust": "auto",
    "trustedMetricGlyphs": [],
    "untrustedMetricGlyphs": []
  },
  "rules": [
    {
      "category": "Letter",
      "subCategory": "Lowercase",
      "factor": 1.0
    },
    {
      "category": "Letter",
      "subCategory": "Uppercase",
      "factor": 1.05
    },
    {
      "category": "Number",
      "factor": 1.0
    },
    {
      "nameRegex": "\\\\.(tf|tosf)$",
      "referenceGlyph": "*",
      "factor": 1.0
    },
    {
      "category": "Punctuation",
      "factor": 0.9
    }
  ]
}
